# Raw source PDFs and binaries — too large for git, plus copyright concerns
00-Sources/papers/
00-Sources/books/
00-Sources/images/
00-Sources/data/
00-Sources/articles/*.pdf

# Quartz: track config + source, but not node_modules / build output / cache
.quartz/node_modules/
.quartz/public/
.quartz-cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Obsidian (per-user UI state)
.obsidian/

# Claude Code per-user / per-project state
.claude/

# MoAI internal state and MCP config
.moai/
.mcp.json

# Review manuscript draft — kept private, not for wiki publication
60-Draft/

# Unrelated MoAI/sub-project directory accidentally nested here
scDNA/

# R
.Rhistory
.Rapp.history

# Partial downloads, temp, editor backups
*.crdownload
*.tmp
*.part
*.swp
*.swo
*~
~$*

# Node
node_modules/

# Python (in case any tooling adds this later)
__pycache__/
*.pyc
.venv/
venv/

# Graphify internal/scratch state — keep only user-facing outputs
graphify-out/.graphify_*
graphify-out/.extract.sh
graphify-out/.validate.py
graphify-out/cache/

# Off-topic clippings moved out of 00-Sources but kept on disk
99-OffTopic/
graphify-out/
